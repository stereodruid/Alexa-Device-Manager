import React, { useState, useEffect, useMemo, useRef } from "react";
import {
  Search,
  Trash2,
  RefreshCw,
  Download,
  Terminal,
  Shield,
  Speaker,
  Power,
  X,
  ChevronLeft,
  ChevronRight,
  Smartphone,
  Home,
  Layers,
  AlertTriangle,
  HelpCircle,
  Circle,
  PowerOff,
  Send,
  Moon,
  Projector,
  Tv,
  Thermometer,
  Radio,
  LockKeyhole,
  Fan,
  Box,
} from "lucide-react";
import { useAlexa } from "./hooks/useAlexa";
import { deviceVisual } from "./deviceVisual";
import {
  deviceName,
  deviceType,
  isEcho,
  isGroup,
  isProtected,
  source,
  reachability,
  enablement,
  canAct,
  filterDevices,
  toggleVisible,
} from "./alexa";

const defaultColumns = [
  "name",
  "description",
  "type",
  "status",
  "source",
  "id",
  "actions",
];
const columnLabels = {
  name: "Name",
  description: "Beschreibung",
  type: "Typ",
  status: "Status",
  source: "Quelle",
  id: "ID",
  actions: "Aktionen",
};
const defaultKpis = [
  "gesamt",
  "online",
  "offline",
  "unbekannt",
  "ohne",
  "echos",
  "ha",
  "gruppen",
  "loeschbar",
  "geschuetzt",
];
const kpiVisuals = {
  gesamt: [Smartphone, "#00A3FF"],
  online: [Circle, "#00FF88"],
  offline: [Circle, "#94A3B8"],
  unbekannt: [HelpCircle, "#EAB308"],
  ohne: [AlertTriangle, "#FF9500"],
  echos: [Speaker, "#00C853"],
  ha: [Home, "#3B82F6"],
  gruppen: [Layers, "#8B5CF6"],
  loeschbar: [Trash2, "#FF3B30"],
  geschuetzt: [Shield, "#64748B"],
};
function KpiIcon({ id }) {
  const [Icon, color] = kpiVisuals[id];
  return (
    <span className="kpi-icon" style={{ color, backgroundColor: color + "18" }}>
      <Icon
        size={18}
        fill={id === "online" || id === "offline" ? "currentColor" : "none"}
      />
    </span>
  );
}
const emptyFilters = {
  search: "",
  type: "",
  status: "",
  origin: "",
  group: "",
  hideProtected: false,
  onlyDeletable: false,
};
const actions = {
  delete: "Dauerhaft löschen",
  enable: "Aktivieren",
  disable: "Deaktivieren",
  on: "Einschalten",
  off: "Ausschalten",
  speak: "Sprachausgabe",
};
function readOrder(key, fallback) {
  try {
    const saved = JSON.parse(localStorage.getItem(key));
    if (!Array.isArray(saved)) return fallback;
    return [
      ...new Set([...saved.filter((x) => fallback.includes(x)), ...fallback]),
    ];
  } catch {
    return fallback;
  }
}
function saveOrder(key, value) {
  try {
    localStorage.setItem(key, JSON.stringify(value));
  } catch {
    /* Storage may be unavailable on the host page. */
  }
}
function reorder(order, from, to) {
  if (!order.includes(from) || !order.includes(to) || from === to) return order;
  const next = order.filter((x) => x !== from);
  next.splice(next.indexOf(to), 0, from);
  return next;
}
function asset(name) {
  return globalThis.chrome?.runtime?.getURL?.(name) || "";
}
const visualIcons = {
  projector: Projector,
  tv: Tv,
  thermostat: Thermometer,
  sensor: Radio,
  lock: LockKeyhole,
  fan: Fan,
  group: Layers,
  speaker: Speaker,
  device: Box,
};
const visualLabels = {
  projector: "Beamer",
  tv: "Fernseher",
  thermostat: "Thermostat",
  sensor: "Sensor",
  lock: "Schloss",
  fan: "Ventilator",
  group: "Gruppe",
  speaker: "Lautsprecher",
  device: "Gerät",
  echo: "Echo",
  plug: "Steckdose",
  light: "Leuchte",
  camera: "Kamera",
  blind: "Jalousie",
  switch: "Schalter",
};
function DeviceImage({ device }) {
  const kind = deviceVisual(device);
  const [failed, setFailed] = useState(false);
  const Icon = visualIcons[kind] || Box;
  if (!visualIcons[kind] && !failed)
    return (
      <img
        src={asset(`${kind}.jpg`)}
        alt={visualLabels[kind]}
        onError={() => setFailed(true)}
      />
    );
  return (
    <span className="device-art" role="img" aria-label={visualLabels[kind]}>
      <Icon size={48} strokeWidth={1.5} />
    </span>
  );
}
function Status({ device }) {
  const status = reachability(device);
  return (
    <div>
      <span
        className={
          status === "Online"
            ? "status-online"
            : status === "Offline"
              ? "status-offline"
              : "muted"
        }
      >
        {status}
      </span>
      <small className="block muted">Alexa: {enablement(device)}</small>
    </div>
  );
}

export default function App() {
  const {
    devices,
    busy,
    error,
    ready,
    loadedAt,
    logs,
    logger,
    fetchDevices,
    execute,
  } = useAlexa();
  const [filters, setFilters] = useState({
    ...emptyFilters,
    hideProtected: true,
  });
  const [selectedId, setSelectedId] = useState(null);
  const [checkedIds, setCheckedIds] = useState(new Set());
  const [sort, setSort] = useState({ key: "name", dir: 1 });
  const [columns, setColumns] = useState(() =>
    readOrder("aura_col_order", defaultColumns),
  );
  const [kpiOrder, setKpiOrder] = useState(() =>
    readOrder("aura_kpi_order", defaultKpis),
  );
  const [pageSize, setPageSize] = useState(50);
  const [page, setPage] = useState(0);
  const [plan, setPlan] = useState(null);
  const [backedUp, setBackedUp] = useState(false);
  const [protectedIds, setProtectedIds] = useState(new Set());
  const [confirmation, setConfirmation] = useState("");
  const [speech, setSpeech] = useState("");
  const logRef = useRef(null);
  useEffect(() => {
    if (!plan) return;
    const previous = document.activeElement;
    const onKey = (event) => {
      if (event.key === "Escape" && !busy) setPlan(null);
      if (event.key !== "Tab") return;
      const items = [
        ...document.querySelectorAll(
          '#aura-root [role="dialog"] button:not(:disabled), #aura-root [role="dialog"] input:not(:disabled)',
        ),
      ];
      if (!items.length) return;
      const index = items.indexOf(document.activeElement);
      if (
        index === -1 ||
        (event.shiftKey && index === 0) ||
        (!event.shiftKey && index === items.length - 1)
      ) {
        event.preventDefault();
        (event.shiftKey ? items.at(-1) : items[0]).focus();
      }
    };
    document.addEventListener("keydown", onKey);
    return () => {
      document.removeEventListener("keydown", onKey);
      if (previous?.isConnected) previous.focus();
    };
  }, [plan, busy]);
  useEffect(() => {
    fetchDevices();
  }, [fetchDevices]);
  useEffect(() => {
    saveOrder("aura_col_order", columns);
  }, [columns]);
  useEffect(() => {
    saveOrder("aura_kpi_order", kpiOrder);
  }, [kpiOrder]);
  useEffect(() => {
    setCheckedIds(new Set());
    setPlan(null);
    setBackedUp(false);
  }, [devices]);
  useEffect(() => {
    if (logRef.current) logRef.current.scrollTop = logRef.current.scrollHeight;
  }, [logs]);
  useEffect(() => {
    setPage(0);
  }, [filters, pageSize, sort]);

  const filtered = useMemo(() => {
    const value = (d) =>
      ({
        name: deviceName(d),
        description: d.description,
        type: deviceType(d),
        status: `${reachability(d)} ${enablement(d)}`,
        source: source(d),
        id: d._admEndpointId || d._admApplianceId || d.id,
      })[sort.key] || "";
    return filterDevices(devices, filters).sort(
      (a, b) =>
        String(value(a)).localeCompare(String(value(b)), "de", {
          numeric: true,
        }) * sort.dir,
    );
  }, [devices, filters, sort]);
  const pages = Math.max(1, Math.ceil(filtered.length / pageSize));
  const currentPage = Math.min(page, pages - 1);
  const visible = filtered.slice(
    currentPage * pageSize,
    (currentPage + 1) * pageSize,
  );
  const selected = devices.find((d) => d.id === selectedId);
  const checked = devices.filter((d) => checkedIds.has(d.id));
  const hiddenCount = checked.filter(
    (d) => !visible.some((x) => x.id === d.id),
  ).length;
  const allVisible =
    visible.length > 0 && visible.every((d) => checkedIds.has(d.id));
  const count = (fn) => devices.filter(fn).length;
  const kpis = {
    gesamt: ["Gesamt", devices.length, {}],
    online: [
      "Online",
      count((d) => reachability(d) === "Online"),
      { status: "Online" },
    ],
    offline: [
      "Offline",
      count((d) => reachability(d) === "Offline"),
      { status: "Offline" },
    ],
    unbekannt: [
      "Unbekannt",
      count((d) => reachability(d) === "Unbekannt"),
      { status: "Unbekannt" },
    ],
    ohne: [
      "Ohne Endpoint",
      count((d) => !d._admEndpointId),
      { status: "Ohne Endpoint" },
    ],
    echos: ["Echos", count(isEcho), { status: "Echos" }],
    ha: [
      "Home Assistant",
      count((d) => source(d) === "Home Assistant"),
      { origin: "Home Assistant" },
    ],
    gruppen: ["Gruppen", count(isGroup), { status: "Gruppen" }],
    loeschbar: [
      "Löschbar",
      count((d) => canAct(d, "delete") && !isProtected(d)),
      { onlyDeletable: true },
    ],
    geschuetzt: [
      "Geschützt",
      count((d) => isProtected(d) || !canAct(d, "delete")),
      { status: "Geschützt" },
    ],
  };
  function toggle(id) {
    setCheckedIds((prev) => {
      const next = new Set(prev);
      next.has(id) ? next.delete(id) : next.add(id);
      return next;
    });
  }
  function exportJson() {
    try {
      const url = URL.createObjectURL(
        new Blob([JSON.stringify(devices, null, 2)], {
          type: "application/json",
        }),
      );
      const a = document.createElement("a");
      a.href = url;
      a.download = `alexa-devices-${new Date().toISOString().replace(/[:.]/g, "-")}.json`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 5000);
      logger("JSON-Download gestartet. Bitte die gespeicherte Datei prüfen.");
    } catch {
      logger("JSON-Sicherung konnte nicht gestartet werden.");
    }
  }
  function preview(action, list = checked) {
    if (busy || !ready || !list.length) return;
    setPlan({ action, list: [...list], text: speech });
    setBackedUp(false);
    setProtectedIds(new Set());
    setConfirmation("");
  }
  async function submit() {
    if (
      !plan ||
      !ready ||
      busy ||
      !backedUp ||
      plan.list.some(
        (d) => plan.action !== "speak" && !canAct(d, plan.action),
      ) ||
      plan.list.some((d) => isProtected(d) && !protectedIds.has(d.id)) ||
      (plan.action === "delete" && confirmation !== "DELETE")
    )
      return;
    const ok = await execute(plan.list, plan.action, {
      backup: backedUp,
      preview: true,
      allowProtectedIds: [...protectedIds],
      text: plan.text,
    });
    setPlan(null);
    if (ok) {
      setCheckedIds(new Set());
      if (plan.action === "speak") setSpeech("");
    }
  }
  const filter = (key, value) =>
    setFilters((prev) => ({ ...prev, [key]: value }));
  const blocked = busy || !ready;
  return (
    <div className="aura-app">
      <header className="panel app-header">
        <div className="brand">
          <img src={asset("icon128.png")} alt="" />
          <div>
            <h1>Aura Device Master</h1>
            <p className="muted">
              Alexa-Geräte verwalten · lokal in deiner Amazon-Sitzung
            </p>
          </div>
        </div>
        <div className="toolbar">
          <button onClick={exportJson} disabled={!devices.length}>
            <Download size={16} /> JSON sichern
          </button>
          <button
            className="primary"
            disabled={busy || Boolean(plan)}
            onClick={fetchDevices}
          >
            <RefreshCw size={16} className={busy ? "spin" : ""} />
            {busy ? "Bitte warten …" : "Neu laden"}
          </button>
          <button
            aria-label="Manager schließen"
            disabled={busy}
            onClick={() => window.dispatchEvent(new Event("aura-close"))}
          >
            <X size={16} />
          </button>
        </div>
      </header>
      {error && (
        <div role="alert" className="notice error">
          {error}
        </div>
      )}
      <div className="kpis">
        {kpiOrder.map((id) => (
          <button
            className="panel kpi"
            key={id}
            draggable
            onDragStart={(e) => e.dataTransfer.setData("aura-kpi", id)}
            onDragOver={(e) => e.preventDefault()}
            onDrop={(e) => {
              e.preventDefault();
              setKpiOrder((prev) =>
                reorder(prev, e.dataTransfer.getData("aura-kpi"), id),
              );
            }}
            onClick={() => setFilters({ ...emptyFilters, ...kpis[id][2] })}
          >
            <KpiIcon id={id} />
            <span className="kpi-copy">
              <strong>{kpis[id][1]}</strong>
              <span>{kpis[id][0]}</span>
            </span>
          </button>
        ))}
      </div>
      <main className="workspace">
        <section className="panel device-list">
          <div className="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>
                    <input
                      aria-label="Alle auf dieser Seite auswählen"
                      type="checkbox"
                      checked={allVisible}
                      disabled={!visible.length || busy}
                      onChange={() =>
                        setCheckedIds((prev) => toggleVisible(prev, visible))
                      }
                    />
                  </th>
                  {columns.map((col) => (
                    <th
                      key={col}
                      draggable
                      onDragStart={(e) =>
                        e.dataTransfer.setData("aura-col", col)
                      }
                      onDragOver={(e) => e.preventDefault()}
                      onDrop={(e) => {
                        e.preventDefault();
                        setColumns((prev) =>
                          reorder(
                            prev,
                            e.dataTransfer.getData("aura-col"),
                            col,
                          ),
                        );
                      }}
                    >
                      <button
                        disabled={col === "actions"}
                        onClick={() =>
                          setSort((prev) => ({
                            key: col,
                            dir: prev.key === col ? -prev.dir : 1,
                          }))
                        }
                      >
                        {columnLabels[col]}{" "}
                        {sort.key === col ? (sort.dir === 1 ? "↑" : "↓") : ""}
                      </button>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {visible.map((d) => (
                  <tr
                    key={d.id}
                    className={selectedId === d.id ? "selected" : ""}
                    onClick={() => setSelectedId(d.id)}
                  >
                    <td>
                      <input
                        type="checkbox"
                        aria-label={`${deviceName(d)} auswählen`}
                        checked={checkedIds.has(d.id)}
                        disabled={busy}
                        onClick={(e) => e.stopPropagation()}
                        onChange={() => toggle(d.id)}
                      />
                    </td>
                    {columns.map((col) => (
                      <td key={col}>
                        {col === "name" ? (
                          <button
                            className="device-name"
                            onClick={() => setSelectedId(d.id)}
                          >
                            {deviceName(d)}
                            {isProtected(d) && (
                              <Shield size={13} aria-label="Geschützt" />
                            )}
                          </button>
                        ) : col === "description" ? (
                          <span className="description">
                            {d.description || "–"}
                          </span>
                        ) : col === "type" ? (
                          <span className="tag">{deviceType(d)}</span>
                        ) : col === "status" ? (
                          <Status device={d} />
                        ) : col === "source" ? (
                          source(d)
                        ) : col === "id" ? (
                          <span
                            className="id"
                            title={
                              d._admEndpointId || d._admApplianceId || d.id
                            }
                          >
                            {d._admEndpointId || d._admApplianceId || d.id}
                          </span>
                        ) : (
                          <div className="toolbar">
                            <button
                              disabled={blocked || !canAct(d, "disable")}
                              title={
                                d._admEnablement === "DISABLED_BY_CUSTOMER"
                                  ? "Aktivieren"
                                  : "Deaktivieren"
                              }
                              onClick={(e) => {
                                e.stopPropagation();
                                preview(
                                  d._admEnablement === "DISABLED_BY_CUSTOMER"
                                    ? "enable"
                                    : "disable",
                                  [d],
                                );
                              }}
                            >
                              <Shield size={15} />
                            </button>
                            <button
                              disabled={blocked || !canAct(d, "delete")}
                              title="Löschen prüfen"
                              onClick={(e) => {
                                e.stopPropagation();
                                preview("delete", [d]);
                              }}
                            >
                              <Trash2 size={15} />
                            </button>
                          </div>
                        )}
                      </td>
                    ))}
                  </tr>
                ))}
                {!visible.length && (
                  <tr>
                    <td colSpan={columns.length + 1} className="empty">
                      {busy
                        ? "Geräte werden geladen …"
                        : ready
                          ? "Keine Geräte für diese Filter."
                          : "Keine vollständigen Gerätedaten verfügbar. Bitte neu laden."}
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
          <footer className="table-footer">
            <span>
              {filtered.length} Treffer · {checked.length} ausgewählt
              {hiddenCount > 0 && ` (${hiddenCount} außerhalb dieser Seite)`}
            </span>
            <div className="toolbar">
              <label>
                Pro Seite{" "}
                <select
                  aria-label="Einträge pro Seite"
                  value={pageSize}
                  onChange={(e) => setPageSize(Number(e.target.value))}
                >
                  {[10, 50, 100].map((n) => (
                    <option key={n}>{n}</option>
                  ))}
                </select>
              </label>
              <button
                aria-label="Vorherige Seite"
                disabled={currentPage === 0}
                onClick={() => setPage(currentPage - 1)}
              >
                <ChevronLeft size={16} />
              </button>
              <span>
                {currentPage + 1} / {pages}
              </span>
              <button
                aria-label="Nächste Seite"
                disabled={currentPage >= pages - 1}
                onClick={() => setPage(currentPage + 1)}
              >
                <ChevronRight size={16} />
              </button>
            </div>
          </footer>
        </section>
        <aside className="panel sidebar">
          {selected ? (
            <>
              <div className="detail-heading">
                <DeviceImage
                  key={selected.id + deviceVisual(selected)}
                  device={selected}
                />
                <div>
                  <h2>{deviceName(selected)}</h2>
                  <p className="muted">
                    {selected.description || "Keine Beschreibung"}
                  </p>
                </div>
              </div>
              <div className="detail-toolbar" aria-label="Geräteaktionen">
                <button
                  title="JSON sichern"
                  aria-label="JSON sichern"
                  onClick={exportJson}
                >
                  <Download size={20} />
                </button>
                <button
                  title={
                    selected._admEnablement === "DISABLED_BY_CUSTOMER"
                      ? "Aktivieren"
                      : "Deaktivieren"
                  }
                  aria-label={
                    selected._admEnablement === "DISABLED_BY_CUSTOMER"
                      ? "Aktivieren"
                      : "Deaktivieren"
                  }
                  disabled={blocked || !canAct(selected, "enable")}
                  onClick={() =>
                    preview(
                      selected._admEnablement === "DISABLED_BY_CUSTOMER"
                        ? "enable"
                        : "disable",
                      [selected],
                    )
                  }
                >
                  <Shield size={20} />
                </button>
                <button
                  className="delete-icon"
                  title="Löschen"
                  aria-label="Löschen"
                  disabled={blocked || !canAct(selected, "delete")}
                  onClick={() => preview("delete", [selected])}
                >
                  <Trash2 size={20} />
                </button>
                <span className="toolbar-divider" />
                <button
                  className="on-icon"
                  title="Einschalten – Zustand unbekannt"
                  aria-label="Einschalten"
                  disabled={blocked || !canAct(selected, "on")}
                  onClick={() => preview("on", [selected])}
                >
                  <Power size={20} />
                </button>
                <button
                  className="off-icon"
                  title="Ausschalten – Zustand unbekannt"
                  aria-label="Ausschalten"
                  disabled={blocked || !canAct(selected, "off")}
                  onClick={() => preview("off", [selected])}
                >
                  <PowerOff size={20} />
                </button>
                <button
                  title="Bitte nicht stören – noch nicht verfügbar"
                  aria-label="Bitte nicht stören – noch nicht verfügbar"
                  disabled
                >
                  <Moon size={20} />
                </button>
              </div>
              <dl className="detail-grid">
                <dt>Typ</dt>
                <dd>{deviceType(selected)}</dd>
                <dt>Status</dt>
                <dd>
                  <Status device={selected} />
                </dd>
                <dt>Quelle¹</dt>
                <dd>{source(selected)}</dd>
                <dt>Geräte-ID</dt>
                <dd
                  className="detail-id"
                  title={
                    selected._admEndpointId ||
                    selected._admApplianceId ||
                    selected.id
                  }
                >
                  {selected._admEndpointId ||
                    selected._admApplianceId ||
                    selected.id}
                </dd>
                <dt>Beschreibung</dt>
                <dd className="detail-id" title={selected.description || ""}>
                  {selected.description || "–"}
                </dd>
                <dt>Löschbar</dt>
                <dd
                  className={
                    canAct(selected, "delete") ? "status-online" : "muted"
                  }
                >
                  {canAct(selected, "delete") ? "Ja" : "Nein"}
                </dd>
                <dt>Geschützt</dt>
                <dd>
                  {isProtected(selected)
                    ? "Ja"
                    : !canAct(selected, "delete")
                      ? "Keine sichere Ziel-ID"
                      : "Nein"}
                </dd>
                <dt>Datenstand</dt>
                <dd>{loadedAt?.toLocaleTimeString("de-DE") || "Unbekannt"}</dd>
              </dl>
              {isEcho(selected) ? (
                <form
                  className="speech-panel"
                  onSubmit={(e) => {
                    e.preventDefault();
                    preview("speak", [selected]);
                  }}
                >
                  <label htmlFor="aura-speech">
                    <Speaker size={14} /> Alexa Sprachausgabe
                  </label>
                  <div className="speech-row">
                    <input
                      id="aura-speech"
                      value={speech}
                      maxLength={500}
                      onChange={(e) => setSpeech(e.target.value)}
                      placeholder="Was soll Alexa sagen?"
                    />
                    <button
                      className="primary"
                      title="Text an Alexa senden"
                      disabled={blocked || !speech.trim()}
                    >
                      <Send size={16} /> Senden
                    </button>
                  </div>
                </form>
              ) : (
                <div className="speech-panel muted">
                  Für dieses Gerät ist keine Alexa-Sprachausgabe erkannt.
                </div>
              )}
            </>
          ) : (
            <div className="empty">
              <Shield size={36} />
              <h2>Gerät auswählen</h2>
              <p>Wähle einen Eintrag für Details und Aktionen.</p>
            </div>
          )}
          <section className="log">
            <h3>
              <Terminal size={15} /> CLI Terminal
            </h3>
            <div ref={logRef} role="log" aria-label="Aktionsprotokoll">
              {logs.map((line, i) => (
                <p key={i}>{line}</p>
              ))}
            </div>
          </section>
        </aside>
      </main>
      <section className="panel filters" aria-label="Gerätefilter">
        <label className="search">
          <Search size={16} />
          <input
            aria-label="Geräte suchen"
            placeholder="Name, Typ, Quelle oder ID suchen"
            value={filters.search}
            onChange={(e) => filter("search", e.target.value)}
          />
        </label>
        <select
          aria-label="Gerätetyp"
          value={filters.type}
          onChange={(e) => filter("type", e.target.value)}
        >
          <option value="">Alle Gerätetypen</option>
          {[...new Set(devices.map(deviceType))].sort().map((t) => (
            <option key={t}>{t}</option>
          ))}
        </select>
        <select
          aria-label="Statusfilter"
          value={filters.status}
          onChange={(e) => filter("status", e.target.value)}
        >
          <option value="">Alle Status</option>
          {[
            "Online",
            "Offline",
            "Unbekannt",
            "Aktiviert",
            "Deaktiviert",
            "Ohne Endpoint",
            "Geschützt",
            "Echos",
            "Gruppen",
          ].map((s) => (
            <option key={s}>{s}</option>
          ))}
        </select>
        <select
          aria-label="Quelle"
          value={filters.origin}
          onChange={(e) => filter("origin", e.target.value)}
        >
          <option value="">Alle Quellen</option>
          {[...new Set(devices.map(source))].sort().map((s) => (
            <option key={s}>{s}</option>
          ))}
        </select>
        <select
          aria-label="Gruppe"
          value={filters.group}
          onChange={(e) => filter("group", e.target.value)}
        >
          <option value="">Alle Gruppen</option>
          {devices.filter(isGroup).map((d) => (
            <option key={d.id} value={d.id}>
              {deviceName(d)}
            </option>
          ))}
        </select>
        <label>
          <input
            type="checkbox"
            checked={filters.hideProtected}
            onChange={(e) => filter("hideProtected", e.target.checked)}
          />{" "}
          Geschützte ausblenden
        </label>
        <label>
          <input
            type="checkbox"
            checked={filters.onlyDeletable}
            onChange={(e) => filter("onlyDeletable", e.target.checked)}
          />{" "}
          Nur ungeschützte löschbare
        </label>
        <button onClick={() => setFilters({ ...emptyFilters })}>
          Zurücksetzen
        </button>
      </section>
      <footer className="panel action-footer">
        <div>
          <strong>{checked.length} Geräte ausgewählt</strong>
          <small className="block muted">
            Datenstand:{" "}
            {loadedAt ? loadedAt.toLocaleString("de-DE") : "Noch nicht geladen"}{" "}
            · ¹ Quelle ist eine Schätzung.
          </small>
        </div>
        <div className="toolbar wrap">
          <button
            disabled={!checked.length || busy}
            onClick={() => setCheckedIds(new Set())}
          >
            Auswahl leeren
          </button>
          <button
            disabled={blocked || !checked.length}
            onClick={() => preview("disable")}
          >
            Trockenlauf / Vorschau
          </button>
          <button
            disabled={blocked || !checked.length}
            onClick={() => preview("enable")}
          >
            Aktivieren
          </button>
          <button
            disabled={blocked || !checked.length}
            onClick={() => preview("disable")}
          >
            Deaktivieren
          </button>
          <button
            className="danger"
            disabled={blocked || !checked.length}
            onClick={() => preview("delete")}
          >
            <Trash2 size={16} /> Löschen
          </button>
        </div>
      </footer>
      {plan && (
        <div className="modal-backdrop">
          <section
            className="panel modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="aura-plan-title"
          >
            <h2 id="aura-plan-title">{actions[plan.action]} – Vorschau</h2>
            <p>
              Diese {plan.list.length} Ziele sind ausgewählt. Bis zur Ausführung
              wird nichts verändert.
            </p>
            {plan.action === "speak" && <blockquote>{plan.text}</blockquote>}
            <div className="plan-list">
              {plan.list.map((d) => (
                <div className="plan-item" key={d.id}>
                  <strong>{deviceName(d)}</strong>
                  <code>{d._admEndpointId || d._admApplianceId || d.id}</code>
                  {plan.action !== "speak" && !canAct(d, plan.action) && (
                    <p className="status-offline">
                      Keine geeignete Ziel-ID. Bitte Auswahl korrigieren.
                    </p>
                  )}
                  {isProtected(d) && (
                    <label>
                      <input
                        type="checkbox"
                        checked={protectedIds.has(d.id)}
                        onChange={(e) =>
                          setProtectedIds((prev) => {
                            const next = new Set(prev);
                            e.target.checked
                              ? next.add(d.id)
                              : next.delete(d.id);
                            return next;
                          })
                        }
                      />{" "}
                      Dieses geschützte Ziel für diese Aktion freigeben
                    </label>
                  )}
                </div>
              ))}
            </div>
            <button onClick={exportJson}>
              <Download size={16} /> JSON-Sicherung herunterladen
            </button>
            <label className="backup-check">
              <input
                type="checkbox"
                checked={backedUp}
                onChange={(e) => setBackedUp(e.target.checked)}
              />{" "}
              Ich habe die aktuelle JSON-Sicherung gespeichert und die Ziele
              geprüft.
            </label>
            {plan.action === "delete" && (
              <label>
                Dauerhaftes Löschen bestätigen:{" "}
                <input
                  aria-label="DELETE bestätigen"
                  placeholder="DELETE eingeben"
                  value={confirmation}
                  onChange={(e) => setConfirmation(e.target.value)}
                />
              </label>
            )}
            <div className="toolbar modal-actions">
              <button autoFocus disabled={busy} onClick={() => setPlan(null)}>
                Abbrechen
              </button>
              <button
                className={plan.action === "delete" ? "danger" : "primary"}
                disabled={
                  blocked ||
                  !backedUp ||
                  plan.list.some(
                    (d) => plan.action !== "speak" && !canAct(d, plan.action),
                  ) ||
                  plan.list.some(
                    (d) => isProtected(d) && !protectedIds.has(d.id),
                  ) ||
                  (plan.action === "delete" && confirmation !== "DELETE")
                }
                onClick={submit}
              >
                {busy ? "Wird ausgeführt …" : "Jetzt ausführen"}
              </button>
            </div>
          </section>
        </div>
      )}
    </div>
  );
}
