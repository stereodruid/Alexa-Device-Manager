import { useState, useCallback, useRef } from "react";
import { createAlexaClient, runBatch, deviceName, isProtected } from "../alexa";

const client = createAlexaClient();
export function useAlexa() {
  const [devices, setDevices] = useState([]);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState(null);
  const [ready, setReady] = useState(false);
  const [loadedAt, setLoadedAt] = useState(null);
  const [logs, setLogs] = useState(["Aura Device Master bereit."]);
  const lock = useRef(false);
  const latest = useRef([]);
  const readyRef = useRef(false);
  const logger = useCallback(
    (message) =>
      setLogs((prev) => [
        ...prev.slice(-299),
        `[${new Date().toLocaleTimeString("de-DE")}] ${message}`,
      ]),
    [],
  );
  const publish = (data) => {
    latest.current = data;
    setDevices(data);
    setLoadedAt(new Date());
    readyRef.current = true;
    setReady(true);
  };
  const fetchDevices = useCallback(async () => {
    if (lock.current) return;
    lock.current = true;
    setBusy(true);
    setError(null);
    readyRef.current = false;
    setReady(false);
    try {
      const data = await client.load();
      publish(data);
      logger(`${data.length} Geräte vollständig geladen.`);
    } catch (e) {
      setError(
        `${e.message} Vorhandene Daten sind möglicherweise veraltet. Aktionen bleiben gesperrt.`,
      );
      logger(e.message);
    } finally {
      lock.current = false;
      setBusy(false);
    }
  }, [logger]);
  const execute = async (list, action, approval) => {
    if (lock.current || !readyRef.current) return false;
    if (!approval?.backup || !approval?.preview) {
      logger("Sicherung und Vorschau fehlen.");
      return false;
    }
    const current = list.map((d) => latest.current.find((x) => x.id === d.id));
    if (
      current.some(
        (d, i) =>
          !d ||
          d._admEndpointId !== list[i]._admEndpointId ||
          d._admApplianceId !== list[i]._admApplianceId,
      )
    ) {
      logger("Geräteauswahl ist veraltet. Bitte neu prüfen.");
      return false;
    }
    if (
      current.some(
        (d) => isProtected(d) && !approval.allowProtectedIds?.includes(d.id),
      )
    ) {
      logger("Geschützte Ziele sind nicht freigegeben.");
      return false;
    }
    lock.current = true;
    setBusy(true);
    setError(null);
    try {
      if (["on", "off", "speak"].includes(action)) {
        if (current.length !== 1)
          throw new Error("Bitte genau ein Gerät auswählen.");
        if (action === "speak")
          await client.speak(current[0], approval.text || "");
        else await client.power(current[0], action === "on");
        logger(
          `${deviceName(current[0])}: ${action === "speak" ? "Sprachausgabe" : "Schaltbefehl"} angefordert. Der tatsächliche Gerätezustand ist nicht überprüft.`,
        );
        return true;
      }
      const outcome = await runBatch(client, current, action, {
        allowProtectedIds: approval.allowProtectedIds,
        logger,
      });
      if (outcome.devices) publish(outcome.devices);
      if (!outcome.verified) {
        readyRef.current = false;
        setReady(false);
        throw new Error(
          "Nachkontrolle nicht möglich. Ergebnis unbestätigt; bitte später neu laden.",
        );
      }
      const failed = outcome.results.filter((r) => !r.success);
      for (const r of failed)
        logger(
          `${deviceName(r.device)}: ${r.error || "Zielzustand bei Nachkontrolle nicht erreicht."}`,
        );
      logger(
        `${outcome.results.length - failed.length} von ${outcome.results.length} Änderungen bestätigt.`,
      );
      if (failed.length)
        setError(
          `${failed.length} Aktionen fehlgeschlagen oder nicht bestätigt. Details im Protokoll.`,
        );
      return !failed.length;
    } catch (e) {
      setError(e.message);
      logger(e.message);
      return false;
    } finally {
      lock.current = false;
      setBusy(false);
    }
  };
  return {
    devices,
    busy,
    error,
    ready,
    loadedAt,
    logs,
    logger,
    fetchDevices,
    execute,
  };
}
